# Optional but strongly recommended: enables web-search discovery + editorial judgement
ANTHROPIC_API_KEY=
# Optional: YouTube Data API v3 key, used for saturation (competitor video count)
YOUTUBE_API_KEY=

# ---- Leonida Desk site (read at build time; never commit real values) ----
# Public URL of the site. Canonical links, the sitemap and the RSS feed are built from it.
SITE_URL=
# Brand email domain, e.g. leonidadesk.com. Addresses (hello@, editorial@, tips@, partnerships@,
# privacy@) are shown only when this is set. Never put a personal address in the codebase.
PUBLICATION_EMAIL_DOMAIN=
# Newsletter provider endpoint that accepts a JSON POST {email, consent_at, signup_source,
# preferred_games, topic_interests}. Until it is set the signup form is shown as "opening soon".
PUBLIC_NEWSLETTER_ENDPOINT=
# Optional: endpoint that receives analytics events as JSON via sendBeacon. Empty = nothing is sent.
PUBLIC_ANALYTICS_ENDPOINT=
# Optional: contact-form endpoint (not used yet).
PUBLIC_CONTACT_ENDPOINT=
# Higgsfield API credentials for /render (console.higgsfield.ai). Only read when
# config/publishing.yaml -> video.higgsfield.adapter is 'api'. Leave empty for manual generation.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
